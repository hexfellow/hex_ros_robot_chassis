<launch>
    <!-- overridable arguments -->
    <arg name="robot_host" default="192.168.1.100"/>
    <arg name="robot_port" default="8439"/>

    <!-- robot node -->
    <node name="hex_ros_robot_maver" pkg="hex_ros_robot_chassis" type="robot_maver.py" output="screen" >
        <rosparam file="$(find hex_ros_robot_chassis)/config/ros1/maver_params.yaml"/>
        <param name="robot_host" value="$(arg robot_host)"/>
        <param name="robot_port" value="$(arg robot_port)"/>
    </node>
</launch>
